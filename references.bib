@INPROCEEDINGS{11170005,
  author={Seo, Yujin and Kim, Young-Sik},
  booktitle={2025 Sixteenth International Conference on Ubiquitous and Future Networks (ICUFN)}, 
  title={Post-Quantum Cryptography Migration on V2X Certificate using KpqC Algorithms*}, 
  year={2025},
  volume={},
  number={},
  pages={12-14},
  abstract={Connected vehicles utilizing Vehicle-to-Everything (V2X) communication enhance road safety and transportation efficiency, supporting cooperative autonomous driving through real-time interactions. However, increased connectivity raises cyber-attack risks, endangering driver and pedestrian safety. This highlights the urgent need to integrate Post-Quantum Cryptography (PQC) into vehicular communications [6]. In this paper, we implement the Korean PQC digital signature algorithm HAETAE for V2X environments and compare its performance with the NIST PQC signature scheme, ML-DSA which is derived from CRYSTALS-DILITHIUM, and traditional signatures, RSA, and ECC under TLS 1.3 environments. Results indicate that PQC algorithms introduce substantial overhead, whereas traditional algorithms produce smaller certificates. Specifically, HAETAE provides more efficient certificates than ML-DSA [3], minimizing latency impacts in TLS operations. These findings inform the critical balance between enhanced security and certificate size, guiding future post-quantum TLS designs.},
  keywords={Pedestrians;System performance;Fitting;NIST;Elliptic curve cryptography;Road safety;Real-time systems;Safety;Cryptography;Vehicle-to-everything;Post-Quantum Cryptography;TLS;V2X;KpqC;signature;certificates},
  doi={10.1109/ICUFN65838.2025.11170005},
  url={https://doi.org/10.1109/ICUFN65838.2025.11170005},
  ISSN={2165-8536},
  month={July},}
  
  @ARTICLE{10838531,
  author={Lohmiller, Nils and Kaniewski, Sabrina and Menth, Michael and Heer, Tobias},
  journal={IEEE Access}, 
  title={A Survey of Post-Quantum Cryptography Migration in Vehicles}, 
  year={2025},
  volume={13},
  number={},
  pages={10160-10176},
  abstract={The advent of quantum computers makes asymmetric cryptographic algorithms insecure and vulnerable. A promising solution to ensure the continued security attributes of confidentiality, integrity, and availability is the use of Post-Quantum Cryptography (PQC) algorithms. The adoption of quantum-safe algorithms takes place at a vastly different pace in different industries. In some industries, adoption processes are slow due to the required adaptation of regulations and standards. At the same time, long-lived products with non-PQC algorithms are more likely to become insecure during their lifetime. Vehicles are a prime example of long-lived products where the adoption of PQC proceeds slowly. When quantum computers are able to break relevant key lengths of asymmetric cryptography and, thus, render current vehicle systems insecure, vehicles that are developed and produced today will most likely remain in use. In this work, we provide a structured and comprehensive overview of the current migration state of PQC algorithms in the automotive area. We address use cases involving asymmetric cryptography in the automotive context that face the challenge of adapting PQC, such as internal vehicle networks, manufacturer-specific communication, and vehicle-to-everything communication. In addition, we review the standards concerning vehicle security and their relevance to PQC. Finally, we identify and discuss open research challenges regarding the adoption of PQC in the automotive domain and further steps towards quantum-safe vehicles.},
  keywords={Cryptography;Standards;Security;Surveys;Automotive engineering;Vehicle-to-everything;Quantum computing;Public key;Computers;NIST;Post-quantum cryptography (PQC);PQC migration;vehicles;V2V;V2X;IoV},
  doi={10.1109/ACCESS.2025.3528562},
  url={https://doi.org/10.1109/ACCESS.2025.3528562},
  ISSN={2169-3536},
  month={},}
  
  @INPROCEEDINGS{10199793,
  author={Yoshizawa, Takahito and Preneel, Bart},
  booktitle={2023 IEEE 97th Vehicular Technology Conference (VTC2023-Spring)}, 
  title={Post-Quantum Impacts on V2X Certificates -- Already at The End of The Road}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={The current certificate definition for vehicle-to-everything (V2X) communication does not support forward compatibility as it does not take migration toward Post Quantum Cryptography (PQC) into account. As a result, introducing PQC-compatible certificates in V2X can result in similar to Distributed Denial-of-Service (DDoS) attack to both legacy and PQC-ready vehicles. This situation will make the deployment of PQC certificates a stalemate situation. In addition, due to the larger public key and signature sizes in PQC algorithms, V2X message size will significantly increase, causing the channel capacity and effective transmission range to decrease. This situation will negatively impact the operation of V2X communication. In this sense, any unnecessary channel usages need to be avoided. We propose to revise the certificate definitions in IEEE 1609 and ETSI Intelligent Transport System (ITS) standards to address and mitigate these issues and pave the way for the migration toward PQC algorithm.},
  keywords={Vehicular and wireless technologies;Channel capacity;Roads;ETSI;Public key;Denial-of-service attack;Quantum cryptography;Vehicular communication;V2X;Post-Quantum Cryptography;PKI;Certificate},
  doi={10.1109/VTC2023-Spring57618.2023.10199793},
  url={https://doi.org/10.1109/VTC2023-Spring57618.2023.10199793},
  ISSN={2577-2465},
  month={June},}
  
  @ARTICLE{11310813,
  author={Li, Shancang and Xie, Yu and Iqbal, Muddear},
  journal={IEEE Transactions on Consumer Electronics}, 
  title={QuanReS: A Hybrid Quantum-Enabled Resilient and Secure V2X Communications Framework in Smart Cities}, 
  year={2026},
  volume={72},
  number={2},
  pages={3940-3948},
  abstract={Advances in quantum computing present a critical challenge to current public-key cryptography, posing significant risks to the infrastructure of smart cities and intelligent transportation systems (ITS). This paper proposes QuanReS, a hybrid framework that integrates Quantum Key Distribution (QKD) with classical infrastructure to deliver quantum-resistant security for Vehicle-to-Everything (V2X) communications. We propose an SDN-based control layer that intelligently manages cryptographic resources by dynamically allocating secure QKD keys to protect high-sensitivity data in V2X communications, while employing post-quantum cryptographic schemes for less critical traffic. Through a comprehensive simulation for ITS applications, we demonstrate that this hybrid approach preserves the low-latency and high-throughput requirements essential for consumer electronics and real-time control systems, while ensuring strong pritection against quantum-enabled attacks. The results demonstrate that QuanReS achieves an effective balance between quantum resilience and practical deployment constraints, providing a scalable architectural framework for securing next-generation urban infrastructures.},
  keywords={Vehicle-to-everything;Security;Cryptography;Smart cities;Quantum computing;Engines;Resilience;Real-time systems;Low latency communication;Hardware;Quantum key distribution;post-quantum cryptography (PQC);smart city security;intelligent transportation systems;V2X communication;quantum resilience;software-defined networking (SDN)},
  doi={10.1109/TCE.2025.3647004},
  url={https://doi.org/10.1109/TCE.2025.3647004},
  ISSN={1558-4127},
  month={May},}

@INPROCEEDINGS{11308316,
  author={Vellela, Sai Srinivas and Anusha, Pothuguntla and Vullam, Nagagopi Raju and Jala, Jeevan and Bellapu, Venkata Subbaiah and Vindhya, A. Shri},
  booktitle={2025 International Conference on Sustainable Communication Networks and Application (ICSCN)}, 
  title={Quantum Cryptography and Key Distribution for Secure Communication in the Post Quantum World}, 
  year={2025},
  volume={},
  number={},
  pages={619-624},
  abstract={Quantum computing is posing a serious risk to classical cryptographic tools such as RSA and ECC as sophisticated quantum algorithms are able to crack their mathematical foundation in a time bound that is a a polynomial in the number of repetitions. In this paper, we will describe the process of integrating Post-Quantum Cryptography (PQC) and Quantum Key Distribution (QKD) into a hybrid approach to secure communications in the post-quantum world. The suggested methodology is a combination of the computational efficiency and scalability of PQC and the information-theoretic security and eavesdropping detection abilities of QKD. Simulation observations indicate that PQC-only systems are both faster in generating keys and scalable, but do not have a strong eavesdropping detection. On the other hand, non-conditional security is only a feature of systems based on QKD, but it is also highly overhead and slows down key rate. The hybrid PQC-Q KD model provides a balanced performance, high resilience, high authentication, high confidentiality, and realistic deployability. On balance, this discussion demonstrates that the hybrid approach is better than standalone methods and can provide a strong solution to protect against new quantum threats. The large-scale network protocol can be optimized, resources and further integration with other emerging technologies, such as 5G/6G, IoT or cloud computing, can be directed in future research.},
  keywords={Hands;Quantum algorithm;Protocols;Scalability;Polynomials;Quantum key distribution;Quantum cryptography;Eavesdropping;Resilience;Information theory;Quantum Cryptography;Quantum Key Distribution (QKD);Post-Quantum Cryptography (PQC);Hybrid Cryptographic Framework},
  doi={10.1109/ICSCN67106.2025.11308316},
  url={https://doi.org/10.1109/ICSCN67106.2025.11308316},
  ISSN={},
  month={Oct},}
  
  @INPROCEEDINGS{11125447,
  author={Blanco, Paula Alonso and Vidarte, Luis Trigo and Casas, Marc Romeu and Mart\'{i}nez Saavedra, Jos\'{e} Ram\'{o}n and De La Iglesia, Fernando and Mur-Petit, Jordi and Pruneri, Valerio},
  booktitle={2025 25th Anniversary International Conference on Transparent Optical Networks (ICTON)}, 
  title={Integration of quantum random number generators with post-quantum cryptography algorithms}, 
  year={2025},
  volume={},
  number={},
  pages={1-5},
  abstract={As quantum technologies advance, the security of popular cryptographic protocols becomes more threatened by the capabilities of Cryptographically Relevant Quantum Computers (CRQCs). In this scenario, Post-Quantum Cryptography (PQC) has become a potential solution to prolong the life of existing Public Key Infrastructure (PKI) systems. However, PQC protocols depend on high-quality randomness for key generation and encapsulation procedures, with the quality of the entropy source potentially having a profound impact on the security of the overall system. In this work, we demonstrate a proof-of-concept enabling the incorporation of Quantum Random Number Generation (QRNG) devices within communication networks using PQC-based Transport Layer Security (TLS).Using open-source cryptographic libraries and commercial QRNG hardware, we demonstrate their use as entropy sources via an Entropy-as-a-Service (EaaS) model. We highlight two particular use cases: a fully virtualized private PKI network and a connection to an external PQC-enabled server. Experimental results show that EaaS QRNG enables real-time entropy monitoring and quality assessment in cryptographic management systems, with negligible impact on TLS handshake time.},
  keywords={Quantum computing;Software algorithms;Entropy;Software;Real-time systems;Quality assessment;Cryptography;Servers;Time factors;Random number generation;entropy as a service;EaaS;post-quantum cryptography;PQC;quantum random number generation;QRNG;quantum-safe cryptography;QSC;transport layer security;TLS},
  doi={10.1109/ICTON67126.2025.11125447},
  url={https://doi.org/10.1109/ICTON67126.2025.11125447},
  ISSN={2161-2064},
  month={July},}
  
  @INPROCEEDINGS{11351237,
  author={Ivanov, Kiril and Nenova, Maria and Tsochev, Georgi},
  booktitle={2025 28th International Symposium on Wireless Personal Multimedia Communications (WPMC)}, 
  title={Hybrid Cryptography: A Framework for Post-Quantum Agility and Resilience}, 
  year={2025},
  volume={},
  number={},
  pages={1-4},
  abstract={Quantum computing threatens classical cryptography, which has prompted the creation of post-quantum cryptography (PQC) and quantum key distribution (QKD). Hybrid cryptography integrates classical, post-quantum, and quantum techniques for achieving multi-layer security and smooth migration towards quantum-safe infrastructures. In this paper, practical deployment patterns, the employment of cryptographic agility, and integration of PQC with QKD are presented with emphasis on hybrid methods as a key strategy for quantum-secure communication.},
  keywords={Wireless communication;Quantum computing;Employment;Public key;Quantum key distribution;Cryptography;Multimedia communication;Quantum cryptography;Resilience;hybrid cryptography;quantum key distribution;post quantum cryptography;cryptographic agility;public key infrastructure;hybrid key derivation functions},
  doi={10.1109/WPMC67460.2025.11351237},
  url={https://doi.org/10.1109/WPMC67460.2025.11351237},
  ISSN={1882-5621},
  month={Nov},}
